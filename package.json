{
  "name": "gurafu",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm run lint && npm test && npm run build",
    "audit": "npm audit --audit-level=high",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "deps:latest": "npm install --save-exact d3@latest elkjs@latest js-yaml@latest && npm install --save-dev --save-exact vite@latest eslint@latest @eslint/js@latest globals@latest prettier@latest"
  },
  "dependencies": {
    "d3": "7.9.2",
    "elkjs": "0.12.2",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "vite": "8.4.0",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Browser-local YAML ontology and graph mapping explorer",
  "license": "Apache-2.0"
}
